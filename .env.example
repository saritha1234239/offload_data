# Copy to .env and fill in. .env is ignored by Git; never commit real values.

# LCCS read-only database (python lccs_connection.py --configure)
LCCS_DB_TYPE=mysql
LCCS_DB_HOST=
LCCS_DB_PORT=3306
LCCS_DB_NAME=
LCCS_DB_USER=
LCCS_DB_PASSWORD=

# Dashboard upload token; must match DASHBOARD_UPLOAD_TOKEN in Render
DASHBOARD_UPLOAD_TOKEN=

# Email (local runs of dashboard_delivery.py; GitHub Actions uses repository secrets)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_RECIPIENTS=
